{% doc %} Selectable publication logo and its testimonial content. {% enddoc %}
<div class="press-testimonial-slide swiper-slide" {{ block.shopify_attributes }}>
  <div data-press-quote hidden><div class="heading-text heading-md">{{ block.settings.quote }}</div></div>
  <button type="button" class="press-testimonial-slide__logo" data-press-logo aria-label="{{ block.settings.name | escape }}" aria-pressed="false">
    {% if block.settings.logo != blank %}{{ block.settings.logo | image_url: width: 320 | image_tag: loading: 'lazy', alt: block.settings.name }}{% else %}{{ block.settings.name | escape }}{% endif %}
  </button>
</div>
{% stylesheet %}
.press-testimonial-slide__logo { display:flex; justify-content:center; align-items:center; width:100%; min-height:48px; padding:8px; border:0; background:transparent; color:inherit; font:inherit; opacity:.3; cursor:pointer; transition:opacity var(--motion-duration-standard); }
.swiper-slide-active > .press-testimonial-slide__logo { opacity:1; }
.press-testimonial-slide__logo img { width:auto; max-width:100%; height:32px; object-fit:contain; }
.press-testimonial-slide__logo:focus-visible { outline:2px solid currentColor; outline-offset:2px; }
{% endstylesheet %}
{% schema %}
{
  "name": "Logo testimonial",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "name",
      "label": "Publication name",
      "default": "Publication"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Testimonial",
      "default": "<p>Share a testimonial from your featured publication.</p>"
    }
  ],
  "presets": [
    {
      "name": "Logo testimonial",
      "category": "Trust & social proof"
    }
  ]
}
{% endschema %}
