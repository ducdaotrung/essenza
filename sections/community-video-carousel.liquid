<section class="community-video-carousel color-scheme {{ section.settings.color_scheme }}" data-community-videos style="--community-padding-top:{{ section.settings.padding_top }}px; --community-padding-bottom:{{ section.settings.padding_bottom }}px; --community-padding-top-mobile:{{ section.settings.padding_top_mobile }}px; --community-padding-bottom-mobile:{{ section.settings.padding_bottom_mobile }}px;">
<div class="container page-width community-video-carousel__content">
{% content_for 'blocks' %}
</div></section>
{% stylesheet %}
.community-video-carousel { padding-top:var(--community-padding-top,80px); padding-bottom:var(--community-padding-bottom,80px); overflow:hidden; }
.community-video-carousel__content { display:flex; flex-direction:column; gap:32px; }
.community-video-carousel .carousel-block__pagination--bullets { --swiper-pagination-bullet-active-width:8px; --swiper-pagination-bullet-active-height:8px; --swiper-pagination-bullet-active-hit-width:24px; }
@media(max-width:767.98px) { .community-video-carousel { padding-top:var(--community-padding-top-mobile,56px); padding-bottom:var(--community-padding-bottom-mobile,56px); } }
{% endstylesheet %}
